---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'mannschaften'))!.data;
const PAGE_FILE = 'src/content/pages/mannschaften.yaml';
---

<Layout title={page.title} description={page.description}>
  <script type="application/json" data-edit-source={PAGE_FILE} set:html={JSON.stringify({ mannschaften: page })} />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1 class="display-lg">Mannschaften</h1>
        <p data-edit={`${PAGE_FILE}::intro`}>{page.intro}</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="team-role">Senioren</div>
          <h2 class="card-title" data-edit={`${PAGE_FILE}::team1Name`}>{page.team1Name}</h2>
          <p class="mb-6">Aktuelle Daten, Kader, Spielplan und Tabelle der ersten Mannschaft bei FuPa.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/team-1" target="_blank" rel="noopener" class="btn btn-primary">Kader</a>
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/tabelle" target="_blank" rel="noopener" class="btn btn-secondary">Tabelle</a>
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/team-1/spielplan" target="_blank" rel="noopener" class="btn btn-secondary">Spielplan</a>
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/liveticker" target="_blank" rel="noopener" class="btn btn-secondary">Liveticker</a>
          </div>
        </div>

        <div class="card">
          <div class="team-role">Senioren</div>
          <h2 class="card-title" data-edit={`${PAGE_FILE}::team2Name`}>{page.team2Name}</h2>
          <p class="mb-6">Aktuelle Daten, Kader, Spielplan und Tabelle der zweiten Mannschaft bei FuPa.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/team-2" target="_blank" rel="noopener" class="btn btn-primary">Kader</a>
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/team-2/tabelle" target="_blank" rel="noopener" class="btn btn-secondary">Tabelle</a>
            <a href="https://www.fupa.net/club/sv-kirch-grottenherten/team-2/spielplan" target="_blank" rel="noopener" class="btn btn-secondary">Spielplan</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
