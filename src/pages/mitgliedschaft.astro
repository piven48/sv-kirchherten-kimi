---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'mitgliedschaft'))!.data;
const PAGE_FILE = 'src/content/pages/mitgliedschaft.yaml';
---

<Layout title={page.title} description={page.description}>
  <script type="application/json" data-edit-source={PAGE_FILE} set:html={JSON.stringify({ mitgliedschaft: page })} />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1 class="display-lg">Mitgliedschaft</h1>
        <p data-edit={`${PAGE_FILE}::intro`}>{page.intro}</p>
      </div>

      <div class="grid-2">
        <div class="card reveal">
          <h2 class="card-title" data-edit={`${PAGE_FILE}::seniorenTitle`}>{page.seniorenTitle}</h2>
          <p class="mb-6" data-edit={`${PAGE_FILE}::seniorenText`}>{page.seniorenText}</p>
          <a href="https://sv-kirchherten.de/wp-content/uploads/2020/10/MitgliedsantragSeniorenabJan.2017.pdf" target="_blank" rel="noopener" class="btn btn-primary">Antrag herunterladen (PDF)</a>
        </div>
        <div class="card reveal">
          <h2 class="card-title" data-edit={`${PAGE_FILE}::juniorenTitle`}>{page.juniorenTitle}</h2>
          <p class="mb-6" data-edit={`${PAGE_FILE}::juniorenText`}>{page.juniorenText}</p>
          <a href="https://sv-kirchherten.de/wp-content/uploads/2020/10/MitgliedsantragJuniorenabJan.2017.pdf" target="_blank" rel="noopener" class="btn btn-primary">Antrag herunterladen (PDF)</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
